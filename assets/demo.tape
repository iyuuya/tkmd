Output assets/demo.gif
Output assets/demo.mp4

Set FontSize 15
Set Width 1100
Set Height 720
Set Theme "Catppuccin Mocha"
Set FontFamily "JetBrainsMono Nerd Font"
Set Padding 20
Set TypingSpeed 55ms

Type "tk -A"
Enter
Sleep 3.5s

Type "tk tree -A"
Enter
Sleep 3.5s

Type "tk dep --cpm -A"
Enter
Sleep 3.5s

Type "tk dep --timeline -A"
Enter
Sleep 3.5s

Type "tk dep --dsm -A"
Enter
Sleep 3.5s

Type "tk review -A"
Enter
Sleep 3.5s
